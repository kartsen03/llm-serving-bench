# Same weights as qwen2.5:1.5b-instruct-fp16; only the sampling defaults change, so that
# Ollama decodes greedily with no repetition penalty, like vLLM with --generation-config vllm.
FROM qwen2.5:1.5b-instruct-fp16
PARAMETER temperature 0
PARAMETER top_p 1
PARAMETER repeat_penalty 1
PARAMETER num_ctx 2048
